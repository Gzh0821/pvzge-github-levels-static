            "objdata": {
                "Flow": [
                    {
                        "Character": "crazydave",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "crazydave",
                        "Action": "TIRED",
                        "Lines": {
                            "en": "My friend has been all restless lately.",
                            "zh": "我的男神最近烦躁不安。"
                        }
                    },
                    {
                        "Character": "crazydave",
                        "Action": "TIRED",
                        "Lines": {
                            "en": "Word is he's been backed up for days.",
                            "zh": "据说是被便秘困扰多日。"
                        }
                    },
                    {
                        "Character": "crazydave",
                        "Action": "TIRED",
                        "Lines": {
                            "en": "Time to prescribe something.",
                            "zh": "是时候开一些药了。"
                        }
                    },
                    {
                        "Character": "crazydave",
                        "Action": "TIRED",
                        "Lines": {
                            "en": "Oh, a few guys are pretty stubborn — they won't take their medicine obediently.",
                            "zh": "对了，有几个家伙比较顽固，不肯乖乖吃药。"
                        }
                    },
                    {
                        "Character": "crazydave",
                        "Action": "TIRED",
                        "Lines": {
                            "en": "Gonna need a different prescription for those guys.",
                            "zh": "得开点别的方子。"
                        }
                    },
                    {
                        "Character": "crazydave",
                        "Action": "NPC_EXIT"
                    },
                    {
                        "Character": "crazydave",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "crazydave",
                        "Action": "TIRED",
                        "Lines": {
                            "en": "If this level looks familiar to you, it's purely coincidence.",
                            "zh": "如果你认为本关在哪里见到过，那纯属巧合。"
                        }
                    },
                    {
                        "Character": "crazydave",
                        "Action": "TIRED",
                        "Lines": {
                            "en": "Just someone's twisted sense of humor.",
                            "zh": "只是某人的恶趣味而已。"
                        }
                    }
                ]
            }
